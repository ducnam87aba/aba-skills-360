# Environment configuration for ABA Skills 360

# WordPress & Database
MYSQL_DATABASE=aba_skills
MYSQL_USER=aba_user
MYSQL_PASSWORD=aba_secret_password
MYSQL_ROOT_PASSWORD=root_secret_password
DB_PORT=3306

WP_PORT=8080
PMA_PORT=8081
WORDPRESS_TABLE_PREFIX=wp_

# Web / Next.js
NEXT_PUBLIC_API_URL=http://localhost:8080/wp-json/aba/v1

# Mocks are ON by default so the UI runs without a backend. To exercise the real
# WordPress /aba/v1 API (PA5), set NEXT_PUBLIC_ENABLE_MOCKS=false; the Next dev
# server then proxies same-origin /wp-json/* to WORDPRESS_ORIGIN. Auth: login
# returns a WordPress Application Password (PA37) that the client replays via
# HTTP Basic — cookie sessions cannot reach /wp-json/ over plain HTTP.
# Demo accounts (seeded by DemoUserSeeder): aba_student_1 / aba_parent_1 /
# aba_teacher_1 / aba_admin, password Aba@Demo2026 (local only).
NEXT_PUBLIC_ENABLE_MOCKS=true
WORDPRESS_ORIGIN=http://localhost:8080
