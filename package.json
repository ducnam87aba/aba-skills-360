{
  "name": "aba-skills-360-monorepo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @aba/web dev",
    "build": "pnpm --filter \"@aba/*\" build",
    "lint": "pnpm --filter \"@aba/*\" lint",
    "typecheck": "pnpm --filter \"@aba/*\" typecheck",
    "test": "vitest run",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@12.14.0",
  "msw": {
    "workerDirectory": [
      "apps/web/public"
    ]
  }
}